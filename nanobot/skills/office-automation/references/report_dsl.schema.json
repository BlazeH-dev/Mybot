{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mybot.local/schemas/office/report_dsl.schema.json",
  "title": "ReportDSL",
  "type": "object",
  "required": ["schema_version", "type", "title", "sections"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "const": "report"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "blocks"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": ["paragraph", "bullets", "metrics", "table"]
                },
                "text": {
                  "type": "string"
                },
                "items": {
                  "type": "array"
                },
                "headers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array"
                },
                "fact_ref": {
                  "type": "string"
                },
                "fact_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
