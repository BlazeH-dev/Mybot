{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mybot.local/schemas/office/slide_dsl.schema.json",
  "title": "SlideDSL",
  "type": "object",
  "required": ["schema_version", "type", "slides"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "const": "slides"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "layout": {
            "enum": ["title_metrics", "bullets"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "fact_ref"],
              "properties": {
                "label": {
                  "type": "string"
                },
                "fact_ref": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "bullets": {
            "type": "array"
          },
          "speaker_notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
