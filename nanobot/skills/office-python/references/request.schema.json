{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mybot.local/schemas/office-python-request-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "format", "selector", "payload", "options"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"enum": ["inspect", "query", "create", "apply", "validate", "render"]},
    "format": {"enum": ["docx", "xlsx", "pptx"]},
    "input_artifact": {"$ref": "#/$defs/artifact"},
    "output_artifact": {"$ref": "#/$defs/artifact"},
    "selector": {"type": "object"},
    "payload": {"type": "object"},
    "options": {
      "type": "object",
      "required": ["artifact_root"],
      "properties": {
        "artifact_root": {"type": "string", "minLength": 1},
        "data_only": {"type": "boolean"},
        "libreoffice": {
          "type": "object",
          "required": ["path", "expected_version"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "expected_version": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}}
    }
  }
}
