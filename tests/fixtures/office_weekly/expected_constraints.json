{
  "schema_version": 1,
  "task": "office_weekly_report",
  "inputs": [
    "sales_data.xlsx",
    "meeting_notes.md"
  ],
  "outputs": {
    "pptx_max_pages": 6,
    "docx_max_pages": 4,
    "required_artifacts": [
      "verified_facts.json",
      "weekly_report.docx",
      "weekly_review.pptx",
      "quality_report.json"
    ]
  },
  "must_include": [
    "GMV",
    "orders",
    "conversion rate",
    "top region",
    "risks",
    "action items"
  ],
  "meeting_coverage": {
    "required_sections": [
      "Conclusions",
      "Risks",
      "Action Items"
    ],
    "minimum_items_per_section": 1
  },
  "numeric_grounding": {
    "require_fact_ids": true,
    "required_metric_ids": [
      "total_gmv_cny",
      "total_orders",
      "conversion_rate",
      "top_region_by_gmv"
    ],
    "tolerances": {
      "currency_cny": 0,
      "count": 0,
      "rate": 0.0001
    }
  }
}
