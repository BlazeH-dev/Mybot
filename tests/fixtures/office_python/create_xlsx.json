{
  "schema_version": 1,
  "operation": "create",
  "format": "xlsx",
  "output_artifact": {"path": "${ARTIFACT_ROOT}/sample.xlsx"},
  "selector": {"kind": "workbook"},
  "payload": {
    "sheets": [
      {
        "name": "Data",
        "rows": [["Item", "Amount"], ["Alpha", 10], ["Beta", 20]],
        "formulas": {"B4": "=SUM(B2:B3)"},
        "charts": [
          {
            "chart_type": "bar",
            "title": "Amounts",
            "data": {"min_col": 2, "min_row": 1, "max_row": 3},
            "categories": {"min_col": 1, "min_row": 2, "max_row": 3},
            "anchor": "D2"
          }
        ]
      }
    ]
  },
  "options": {"artifact_root": "${ARTIFACT_ROOT}"}
}
